# -----------------------------------------------------------------------------
# One shop. Copy to <slug>.env and fill in.
# -----------------------------------------------------------------------------
#   cp infra/shops/_template.env infra/shops/schnittwerk.env
#   $EDITOR infra/shops/schnittwerk.env
#   ./infra/build_shop.sh schnittwerk
#
# This file is sourced by build_shop.sh, so it is shell — quote anything with a
# space or an apostrophe.
#
# For a PROSPECT DEMO, fill in only the identity and colour blocks and leave
# the Appwrite block pointing at the shared demo project. The prospect gets
# their own name, their own colours and a booking flow that really books; they
# do not need infrastructure of their own until they say yes.
# -----------------------------------------------------------------------------

# ── identity ─────────────────────────────────────────────────────────────────

SHOP_NAME='Schnittwerk'
SHOP_TAGLINE='Friseur & Barbier'
SHOP_TIMEZONE='Europe/Berlin'

# Where the customer app will be served. The QR code on every poster and table
# stand points here, so it has to be right before anything is printed.
BOOKING_URL='https://schnittwerk.terminplaner.haey.eu'

# Where the staff panel is served. A separate hostname, not a path on the
# booking site: same origin would mean the customer app's manage tokens and
# the staff session share one localStorage. Leave empty and the deploy
# tooling derives <slug>-team.<same domain>.
STAFF_URL=''

# ── colours ──────────────────────────────────────────────────────────────────
#
# Hex, without the '#'. Set the two anchors and leave the rest empty: the app
# derives the surfaces and the whole dark theme from them. Take them off the
# shop's sign, not off their website — the sign is what they think they look
# like.
#
# Leaving BOTH empty gives the BaBa'Ssam house brand unchanged.

SHOP_PRIMARY='1A3A5C'    # the anchor — buttons, header, selected slots
SHOP_SECONDARY='C9A961'  # the accent — prices, hairlines, highlights

# Escape hatches for a shop that turns up with a real style guide.
SHOP_SURFACE=''
SHOP_BACKGROUND=''
SHOP_ON_SURFACE=''
SHOP_PRIMARY_DARK=''
SHOP_SECONDARY_DARK=''
SHOP_SURFACE_DARK=''
SHOP_BACKGROUND_DARK=''
SHOP_ON_SURFACE_DARK=''

# ── backend ──────────────────────────────────────────────────────────────────
#
# For a demo: leave these on the shared demo project.
# For a real deployment: run setup_barber_db.sh, setup_staff_team.sh and
# deploy_functions.sh against the shop's own project first, then point here.

APPWRITE_ENDPOINT='https://write.haey.eu/v1'
APPWRITE_PROJECT_ID='terminplaner-demo'
APPWRITE_DATABASE_ID='barber_db'
STAFF_TEAM_ID='staff'
BOOKING_FUNCTION_ID='booking-api'
STRIPE_FUNCTION_ID='stripe-deposit'

# ── payments ─────────────────────────────────────────────────────────────────
#
# Empty means the app simply does not offer online payment, which is the right
# state for a demo and for any shop that has not signed up with Stripe yet.
#
# The publishable key is safe in the client — it can only create PaymentMethods.
# The secret key belongs in the Appwrite Function's variables and nowhere else.
#
# A release build refuses to start on a pk_test_ key, so a shop that is taking
# real bookings is never quietly taking no money.

STRIPE_PUBLISHABLE_KEY=''
STRIPE_MERCHANT_ID=''

# ── hosting ──────────────────────────────────────────────────────────────────
#
# Only needed when serving from a sub-path rather than a domain root.

# BASE_HREF='/'
# STAFF_BASE_HREF='/'
