# -----------------------------------------------------------------------------
# Connection details for the web server. Copy to infra/hosting.env.
# -----------------------------------------------------------------------------
#   cp infra/hosting.env.example infra/hosting.env
#
# infra/hosting.env is gitignored and must stay that way. No password goes in
# here either — deploy_web.sh uses SSH keys via your agent, and the server
# should have password authentication switched off entirely.
# See infra/HOSTING.md, step 1.
# -----------------------------------------------------------------------------

DEPLOY_HOST='198.51.100.10'
DEPLOY_USER='deploy'
SSH_PORT='22'

# Where the sites live on the server. Must match the --root passed to
# make_caddyfile.js, which deploy_web.sh handles for you.
DEPLOY_ROOT='/srv/terminplaner'

# Set this when something else already owns ports 80 and 443 on the box —
# Nginx Proxy Manager, Traefik, an existing nginx. Caddy then serves plain
# HTTP on this port as an internal origin, routing by Host header, and the
# proxy in front keeps the certificates.
#
# Leave it unset for a box where Caddy is the only web server and does its
# own TLS.
CADDY_PORT='8080'
